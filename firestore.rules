rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Primitives (Pillar 3)
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection (Pillar 2 & 6)
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || existing().isAdmin == true);
      allow create, update: if isSignedIn() && (isOwner(userId) || incoming().isAdmin == true);
      allow delete: if false;
    }

    // Profiles Collection (Pillar 6)
    match /profiles/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true));
      allow write: if isSignedIn();
    }

    // Investments Collection (Pillar 4)
    match /investments/{investmentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true));
      allow write: if isSignedIn();
    }

    // Deposits Collection (Pillar 4)
    match /deposits/{depositId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true));
      allow write: if isSignedIn();
    }

    // Withdrawals Collection (Pillar 4)
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true));
      allow write: if isSignedIn();
    }

    // Transactions Collection (Pillar 8)
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true));
      allow write: if isSignedIn();
    }

    // Notifications Collection (Pillar 8)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true));
      allow write: if isSignedIn();
    }

    // Referrals Collection
    match /referrals/{referralId} {
      allow read: if isSignedIn() && (resource.data.referrerId == request.auth.uid || resource.data.referredId == request.auth.uid || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true));
      allow write: if isSignedIn();
    }

    // Agreements Collection
    match /agreements/{agreementId} {
      allow read: if true;
      allow write: if isSignedIn() && (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Settings Collection
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isSignedIn() && (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Loans Collection
    match /loans/{loanId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true));
      allow write: if isSignedIn();
    }

    // Eligibility Checks Collection
    match /eligibilityChecks/{checkId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true));
      allow write: if isSignedIn();
    }

    // Chat History Collection
    match /chatHistory/{userId} {
      allow read, write: if isSignedIn() && (isOwner(userId) || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true));
    }
  }
}
